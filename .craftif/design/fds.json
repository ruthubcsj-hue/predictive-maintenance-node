    {
      "id": "purpose",
      "number": "1",
      "title": "Purpose and Scope",
      "blocks": [
        {
          "block": "prose",
          "text": "This firmware is an STM32-oriented GPIO prototype with PA0 recorded as an input and PD12 as an output. Its analysed scope includes the application, board-support and STM32 board-I/O layers; no tasks or transports are identified."
        },
        {
          "block": "subheading",
          "number": "1.1",
          "title": "Source Basis"
